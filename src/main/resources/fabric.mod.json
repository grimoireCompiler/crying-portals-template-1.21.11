{
	"schemaVersion": 1,
	"id": "crying_portals",
	"version": "${version}",
	"name": "Crying Portals",
	"description": "Nether-style portals with Crying Obsidian in their frame. Portals whose frames share the same Crying Obsidian pattern are linked, across any dimension.",
	"authors": [
		"grimoireCompiler"
	],
	"contact": {
		"sources": "https://github.com/grimoireCompiler/crying-portals-template-1.21.11"
	},
	"license": "CC0-1.0",
	"icon": "assets/crying_portals/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"grimoirecompiler.crying_portals.CryingPortals"
		],
		"client": [
			"grimoirecompiler.crying_portals.CryingPortalsClient"
		]
	},
	"mixins": [
		"crying_portals.mixins.json",
		{
			"config": "crying_portals.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}